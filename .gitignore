# Dependencies
node_modules/

# Next.js / build
.next/
out/
dist/
build/
tsconfig.tsbuildinfo

# MkDocs build output (the Docs workflow builds and deploys it fresh)
/site/

# Keep web/dist as a DIRECTORY so `//go:embed all:dist` in web/embed.go compiles
# before the Vite build exists. Only the marker is tracked; every build artefact
# under web/dist stays ignored, index.html included. It used to be index.html
# itself that was tracked, which meant a real Vite output with 113 commits of
# history sat in the repo pointing at two chunks that were never in it: a fresh
# clone rendered a white page with two 404s, and every frontend build showed the
# file as modified.
!web/dist/
web/dist/*
!web/dist/.gitkeep

# Env & secrets
.env
.env.*
!.env.example

# Local data
*.sqlite
*.sqlite-*
/data/
/config/

# Brainstorm / tooling

# Agent worktree scratch space (isolated Agent-tool dispatches)

# Agent worktree scratch space (isolated Agent-tool dispatches)
.claude/worktrees/

# OS / editor
.DS_Store
Thumbs.db
*conflicted copy*

# GSD planning artifacts stay local (never committed)
.planning/

# CrewAI repo-ops crew: its venv and generated reports stay local. A local
# automation/.env would already be covered by the .env rules above.
automation/.venv/
automation/output/

# Playwright harness (never commit artifacts or the built binary)
web/test-results/
web/playwright-report/
.playwright-data/
/bombvault
/bombvault.exe

# Assistant scratch files never belong in a public repo (jdp, standing rule:
# no reference to any assistant, anywhere). The repo guide that used to live
# in CLAUDE.md is in the project vault note instead.
CLAUDE.md
.claude/
